{
  "name": "yijian-local-study",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run typecheck && npm run build && node --import tsx --test tests/rendered-html.test.mjs tests/knowledge-structure.test.mjs tests/pdf-text-structure.test.mjs tests/knowledge-taxonomy.test.mjs tests/today-learning.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "history:codex": "node scripts/export-codex-today.mjs",
    "package:github": "node scripts/package-github.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
